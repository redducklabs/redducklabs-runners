# Red Duck Labs GitHub Actions Runners - Environment Configuration
# Copy this file to .env and configure for your environment

# =============================================================================
# Variables read by the production scripts
# =============================================================================

# REQUIRED. GitHub Personal Access Token with admin:org, repo, and workflow scopes.
# Read by deploy/deploy.sh and scripts/scale-runners.sh (and optionally by
# test/test-deployment.sh for GitHub API checks).
# Get from: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# OPTIONAL. Image tag for docker/build-and-push.sh (defaults to latest).
IMAGE_TAG=latest

# NOTE: Cluster context, namespace, and release name are fixed in
# deploy/deploy.sh (do-sfo3-redducklabs-cluster, arc-runners,
# redducklabs-runners). Scaling bounds and runner/dind resources come from
# deploy/dind-values.yaml. None of these are configurable via .env.

# =============================================================================
# Variables read only by the *.template.sh files
# =============================================================================

# Used by deploy/deploy.template.sh (default: your-cluster-context).
# Get with: kubectl config get-contexts
CLUSTER_CONTEXT=do-sfo3-redducklabs-cluster

# Used by docker/build-and-push.template.sh to form
# ${REGISTRY_URL}/${REGISTRY_NAMESPACE}/github-runner:${IMAGE_TAG}
REGISTRY_URL=registry.digitalocean.com
REGISTRY_NAMESPACE=redducklabs

# =============================================================================
# Template placeholders (deploy/dind-values.template.yaml)
# =============================================================================

# These are NOT environment variables: no script reads them. They are the
# literal placeholder strings in deploy/dind-values.template.yaml and the values
# to replace them with by hand. The template uses YOUR_REGISTRY/YOUR_IMAGE:TAG,
# so YOUR_IMAGE excludes the registry host and the tag.
#
#   YOUR_ORG_OR_REPO  -> redducklabs
#   YOUR-RUNNER-NAME  -> redducklabs-runners
#   YOUR_REGISTRY     -> registry.digitalocean.com
#   YOUR_IMAGE        -> redducklabs/github-runner
#   TAG               -> latest

# =============================================================================
# Usage Instructions
# =============================================================================

# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your actual values
# 3. Export the environment: set -a; source .env; set +a
#    (plain `source .env` does not export, so child scripts would not see it)
# 4. Never commit .env to git!

# Required: GITHUB_TOKEN (deploy/deploy.sh, scripts/scale-runners.sh)
# Optional: IMAGE_TAG (docker/build-and-push.sh)
# CLUSTER_CONTEXT is used only by deploy/deploy.template.sh.
