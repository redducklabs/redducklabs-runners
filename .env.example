# Red Duck Labs GitHub Actions Runners - Local Environment Configuration
#
# Production deployment, scaling, node-pool changes and rollback run only
# through the GitHub Actions workflows, which take their configuration from
# repository secrets (RUNNER_TOKEN, DO_TOKEN) and optional repository variables
# (see README.md, "Prerequisites"). Nothing in CI reads this file.
#
# This file lists only the variables the local scripts actually read. Copy it
# to .env (which is git-ignored), fill in your values, and export them:
#
#   cp .env.example .env
#   set -a; source .env; set +a
#
# A plain `source .env` sets shell variables without exporting them, so the
# scripts would not see them. Never commit .env.

# =============================================================================
# GitHub
# =============================================================================

# Personal Access Token. Read by the legacy local helpers deploy/deploy.sh,
# deploy/deploy.template.sh, scripts/runner-admin.sh and
# scripts/emergency-stop.sh. Registration needs admin:org and repo; the
# read-only scripts (scale-runners.sh, ci-usage-report.sh) use `gh auth`
# instead.
GITHUB_TOKEN=ghp_your_token_here

# =============================================================================
# Kubernetes
# =============================================================================

# kubectl context. scripts/scale-runners.sh switches to it (default
# do-sfo3-redducklabs-cluster); deploy/deploy.template.sh uses it with default
# your-cluster-context. deploy/deploy.sh hardcodes the Red Duck Labs context.
CLUSTER_CONTEXT=do-sfo3-redducklabs-cluster

# Read only by deploy/deploy.template.sh (defaults arc-runners and
# github-runners). The Red Duck Labs scripts and workflows require namespace
# arc-runners and release redducklabs-runners.
NAMESPACE=arc-runners
RELEASE_NAME=redducklabs-runners

# =============================================================================
# Container registry
# =============================================================================

# Image tag pushed by docker/build-and-push.sh and
# docker/build-and-push.template.sh (default latest). The fleet runs
# registry.digitalocean.com/redducklabs/github-runner:latest, so pushing
# latest by hand reaches new runner pods without the CI image gates; use a
# test tag for manual builds.
IMAGE_TAG=latest

# Read only by docker/build-and-push.template.sh (defaults
# registry.example.com and your-org). The image is
# ${REGISTRY_URL}/${REGISTRY_NAMESPACE}/github-runner:${IMAGE_TAG}.
# Log in first, for DigitalOcean with `doctl registry login`.
REGISTRY_URL=registry.digitalocean.com
REGISTRY_NAMESPACE=redducklabs

# =============================================================================
# Template placeholders (for reuse by other organizations)
# =============================================================================

# No script substitutes these. They document what to put in place of each
# placeholder when you copy deploy/dind-values.template.yaml (to
# deploy/dind-values.yaml, which deploy/deploy.template.sh reads); the Red Duck
# Labs values are shown.
#
# YOUR_ORG_OR_REPO       -> redducklabs              (githubConfigUrl)
# YOUR-RUNNER-NAME       -> redducklabs-runners      (runnerScaleSetName; runs-on label)
# YOUR-RUNNER-GROUP      -> redducklabs-private-runners (runnerGroup)
# YOUR_BASELINE_POOL     -> github-runners-pool-16g  (baseline node-pool affinity)
# YOUR_REGISTRY          -> registry.digitalocean.com
# YOUR_IMAGE:TAG         -> redducklabs/github-runner:latest
# your-registry-secret   -> do-registry-secret       (imagePullSecrets, commented out)
